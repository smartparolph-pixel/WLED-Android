<?xml version="1.0" encoding="utf-8"?>
<!-- Lantern WiFi passwords are encrypted with a key that never leaves the phone: don't back them up. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="lantern_wifi.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="lantern_wifi.xml" />
    </device-transfer>
</data-extraction-rules>
